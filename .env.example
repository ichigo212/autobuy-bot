# ---- Required ----
# Discord bot token from the Developer Portal (Bot → Reset Token).
BOT_TOKEN=your-bot-token-here

# MongoDB connection string. start.bat / `npm start` runs a local database
# automatically and ignores this; it's only used with `npm run start:remote-db`.
MONGODB_URI=mongodb://127.0.0.1:27017/autobuy

# Comma-separated Discord user IDs with full admin (owner) access.
OWNER_IDS=your-discord-id-here

# Comma-separated role IDs allowed to run staff commands (Manage Server also works).
STAFF_ROLE_IDS=

# ---- Branding ----
# Currency label: a word ("credits", "PHP") or a symbol ("₱", "$").
CURRENCY=credits
BRAND=AutoBuy
EMBED_COLOR=#5865F2
# Optional small logo shown on store/product embeds (https://...png)
ICON_URL=
# Optional wide banner shown at the bottom of the store embed (https://...png)
BANNER_URL=

# ---- GCash top-ups (/topup shows these to buyers) ----
GCASH_NUMBER=09XXXXXXXXX
GCASH_NAME=Juan D.
# Optional: direct link to your GCash QR image (https://...png)
GCASH_QR_URL=
# Optional extra note shown on the GCash card (use \n for a new line).
GCASH_NOTE=Rate: P1 = 1 credit\nMinimum top-up: P20

# Largest single top-up a user can submit, and how many can wait for review at once.
MAX_TOPUP=1000000
MAX_PENDING_TOPUPS=3

# ---- Stock ----
# Stock at or below this shows as "low" and posts a staff alert in the log channel.
LOW_STOCK_THRESHOLD=3

# Timezone for "today", the daily chart and the nightly report.
TIMEZONE=Asia/Manila
